FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/workspace/apps/api:/workspace/apps/recorder:/workspace/scripts
ENV TZ=Asia/Yekaterinburg

WORKDIR /workspace

RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      acl \
      ca-certificates \
      ffmpeg \
      git \
      postgresql-client \
      tzdata; \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime; \
    echo $TZ > /etc/timezone; \
    rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements-test.lock /tmp/requirements-test.lock

RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-test.lock

CMD ["pytest", "apps/api/tests"]
